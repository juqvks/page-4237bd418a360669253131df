th{font-family:var(--mono);font-size:11.5px;letter-spacing:.14em;text-transform:uppercase;color:var(--muted);font-weight:600;border-bottom:1px solid var(--line-soft);white-space:nowrap}\ntable.plans tbody th{font-weight:700;color:#fff;white-space:nowrap;border-bottom:1px solid var(--line)}\ntable.plans tbody tr:hover{background:#101210}\n.price-cell{font-family:var(--mono);color:var(--green);font-size:15px}\n.price-sub{display:block;color:var(--muted);font-size:12px;font-family:var(--mono);margin-top:4px}\n.tag-rec{display:inline-block;font-family:var(--mono);font-size:10.5px;letter-spacing:.12em;border:1px solid var(--green);color:var(--green);padding:1px 7px;margin-left:8px;vertical-align:middle}\n.feature-list{list-style:none;margin:0;padding:0}\n.feature-list li{position:relative;padding-left:14px;margin:0 0 5px;color:#c9cec5}\n.feature-list li::before{content:\"\";position:absolute;left:0;top:.72em;width:5px;height:1px;background:var(--green-dim)}\n.col-features{min-width:280px}\n.plan-foot{margin:18px 0 0;font-size:13px;color:var(--muted);max-width:46em}\n\n/* 客户端区块 */\n.clients{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:0 56px}\n.client{padding:18px 0;border-bottom:1px solid var(--line)}\n.client h3{font-size:15.5px;margin:0 0 5px;color:#fff;font-weight:700}\n.client p{margin:0 0 6px;font-size:14.5px;color:#b9beb6}\n.client .meta{font-family:var(--mono);font-size:11.5px;letter-spacing:.08em;color:var(--muted)}\n.client .meta a{color:var(--green)}\n\n/* FAQ 双栏问答 */\n.faq{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:0 56px}\n.qa{padding:16px 0;border-bottom:1px dashed var(--line)}\n.qa h3{font-size:15.5px;margin:0 0 6px;color:#fff;font-weight:700}\n.qa h3 .q{font-family:var(--mono);color:var(--green);margin-right:8px;font-size:13px}\n.qa p{margin:0;font-size:14.5px;color:#b9beb6}\n.qa p .a{font-family:var(--mono);color:var(--green-dim);margin-right:8px;font-size:13px}\n\n/* 页脚 */\n.foot{padding:40px 0 60px;font-size:13px;color:var(--muted)}\n.foot-grid{display:flex;justify-content:space-between;gap:24px;flex-wrap:wrap}\n.foot strong{color:#dfe3da;font-family:var(--mono);letter-spacing:.14em;font-weight:600}\n.foot nav{display:flex;gap:18px;flex-wrap:wrap;font-family:var(--mono);letter-spacing:.06em}\n.foot nav a{color:#b9beb6}\n.foot nav a:hover{color:var(--green)}\n\n@media (max-width:880px){\n  .hero-grid{grid-template-columns:minmax(0,1fr);gap:36px}\n  .hero-aside{border-left:2px solid var(--green)}\n  .clients,.faq{grid-template-columns:minmax(0,1fr);gap:0}\n  .hero{padding-top:40px}\n  .sect{padding:44px 0}\n}\n@media (max-width:560px){\n  body{font-size:15.5px}\n  .topnav{gap:4px 14px;font-size:12px}\n  .sect-head{gap:12px}\n  table.plans{min-width:640px;font-size:14px}\n}\n</style><header class=\"topbar\">\n  <div class=\"wrap topbar-inner\">\n    <a class=\"brandmark\" href=\"#top\"><span class=\"dot\"></span>miaoss</a>\n    <nav class=\"topnav\" aria-label=\"页面目录\">\n      <a href=\"#read\">阅读方法</a>\n      <span class=\"sep\">/</span>\n      <a href=\"#plans\">套餐对照</a>\n      <span class=\"sep\">/</span>\n      <a href=\"#clients\">客户端</a>\n      <span class=\"sep\">/</span>\n      <a href=\"#faq\">常见问题</a>\n    </nav>\n  </div>\n</header>\n\n<main id=\"top\">\n\n  <section class=\"hero wrap\">\n    <div class=\"hero-grid\">\n      <div>\n        <p class=\"hero-kicker\">Product Note · miaoss</p>\n        <h1 id=\"brand-title\">miaoss：<br>先读<em>说明</em>，再做选择</h1>\n        <p class=\"hero-lede\">这份页面不打算用形容词说服你。它只做一件事：把 miaoss 的套餐栏目、权益条目与常见疑问按同一套顺序摊开，让你自己比对，自己决定。</p>\n        <div class=\"hero-body\">\n          <p>选择一项服务时，最容易被忽略的不是价格，而是条目之间的差在哪里。三个套餐并列写在一起时，差异是可见的；分散在几段宣传文字里时，差异就被语气吃掉了。</p>\n          <p>因此本页把套餐横向排进一张表：额度、设备数量、线路与支持方式各占一列，同一行说的是同一件事。客户端部分只说明各平台的存在与获取方式，不承诺本页未记录的具体参数。FAQ 分两栏并列，方便你在同一屏里找到相关联的两三个问题。</p>\n        </div>\n        <span class=\"dropline\">页面结构 — 01 阅读方法 / 02 套餐对照 / 03 客户端 / 04 常见问题</span>\n      </div>\n      <aside class=\"hero-aside\" aria-label=\"页面摘要\">\n        <h2>Reading Guide</h2>\n        <dl>\n          <dt>文档类型</dt>\n          <dd>产品说明页</dd>\n          <dt>套餐数量</dt>\n          <dd>3 档，横向对照</dd>\n          <dt>常见问题</dt>\n          <dd>8 条，双栏并列</dd>\n          <dt>阅读顺序</dt>\n          <dd>额度 → 设备 → 线路 → 支持</dd>\n          <dt>价格来源</dt>\n          <dd>见套餐对照表标注</dd>\n        </dl>\n      </aside>\n    </div>\n  </section>\n\n  <section class=\"sect wrap\" id=\"read\">\n    <div class=\"sect-head\">\n      <span class=\"sect-num\">01</span>\n      <h2 id=\"read-title\">阅读方法</h2>\n    </div>\n    <p class=\"sect-note\">以下三条是使用本页的先后顺序。按此顺序阅读，后续区块不需要往回翻。</p>\n    <div class=\"stack\">\n      <article class=\"use-item\">\n        <span class=\"idx\">STEP 01</span>\n        <h3>先确认额度与设备数这两行</h3>\n        <p>流量额度与同时在线设备数是约束条件，其余条目都在这两项之内发挥作用。先比较这两行，可以排除大部分不适合的选项，剩下的再逐条对照权益细节。</p>\n      </article>\n      <article class=\"use-item\">\n        <span class=\"idx\">STEP 02</span>\n        <h3>再确认线路类型与支持方式</h3>\n        <p>线路与支持方式决定了你在遇到拥堵或故障时能做什么。套餐对照表中这两行写得较细，请连同括号内的限定词一起读完，不要只取关键词。</p>\n      </article>\n      <article class=\"use-item\">\n        <span class=\"idx\">STEP 03</span>\n        <h3>最后看客户端与常见问题</h3>\n        <p>客户端区块说明各平台的获取途径；常见问题区块回答订阅周期、设备切换与配置顺序这类实际操作上的疑问。若仍有未覆盖的条目，本页不做推断式补充。</p>\n      </article>\n    </div>\n  </section>\n\n  <section class=\"sect wrap\" id=\"plans\">\n    <div class=\"sect-head\">\n      <span class=\"sect-num\">02</span>\n      <h2 id=\"plans-title\">套餐对照</h2>\n    </div>\n    <p class=\"sect-note\">三个套餐按列排列，同一行描述同一项内容。月付与年付价格分别列出，年付价格为按年一次性支付的总额。</p>\n    <div class=\"table-scroll\">\n      <table class=\"plans\">\n        价格与权益以本表所列条目为准；未列出的项目在本页不视为已包含。\n        <thead>\n          <tr>\n            <th>对照项</th>\n            <th>基础版</th>\n            <th>旗舰版<span class=\"tag-rec\">推荐</span></th>\n            <th>团队版</th>\n          </tr>\n        </thead>\n        <tbody>\n          <tr>\n            <th>月付价格</th>\n            <td class=\"price-cell\">¥15/月</td>\n            <td class=\"price-cell\">¥35/月</td>\n            <td class=\"price-cell\">¥85/月</td>\n          </tr>\n          <tr>\n            <th>年付价格</th>\n            <td class=\"price-cell\">¥150/年<span class=\"price-sub\">按年一次性支付</span></td>\n            <td class=\"price-cell\">¥350/年<span class=\"price-sub\">按年一次性支付</span></td>\n            <td class=\"price-cell\">¥850/年<span class=\"price-sub\">按年一次性支付</span></td>\n          </tr>\n          <tr>\n            <th>每月流量</th>\n            <td>100GB</td>\n            <td>300GB</td>\n            <td>1000GB</td>\n          </tr>\n          <tr>\n            <th>同时在线设备</th>\n            <td>3 台</td>\n            <td>5 台</td>\n            <td>20 台</td>\n          </tr>\n          <tr>\n            <th class=\"col-features\">权益条目</th>\n            <td>\n              <ul class=\"feature-list\">\n                <li>解锁基础流媒体</li>\n                <li>普通线路节点池</li>\n              </ul>\n            </td>\n            <td>\n              <ul class=\"feature-list\">\n                <li>全节点原生流媒体解锁</li>\n                <li>IPLC 专线游戏加速优化</li>\n                <li>7×24 优先工单支持</li>\n              </ul>\n            </td>\n            <td>\n              <ul class=\"feature-list\">\n                <li>VIP 专属高带宽节点</li>\n                <li>支持企业定制路由</li>\n                <li>专属客户经理服务</li>\n              </ul>\n            </td>\n          </tr>\n          <tr>\n            <th>适用情形</th>\n            <td>单人日常使用，设备数量有限</td>\n            <td>多设备并行、对流媒体与线路质量有要求</td>\n            <td>多人协作，需要统一路由策略与对接人</td>\n          </tr>\n        </tbody>\n      </table>\n    </div>\n    <p class=\"plan-foot\">表内未出现的性能数值、节点数量与覆盖地区，本页不做说明；请以你实际使用的版本与配置为准。</p>\n  </section>\n\n  <section class=\"sect wrap\" id=\"clients\">\n    <div class=\"sect-head\">\n      <span class=\"sect-num\">03</span>\n      <h2 id=\"clients-title\">客户端</h2>\n    </div>\n    <p class=\"sect-note\">以下按平台说明客户端的存在情况与获取方式。本页不提供下载地址，获取途径请以你订阅后收到的说明为准。</p>\n    <div class=\"clients\">\n      <article class=\"client\">\n        <h3>桌面端 · Windows</h3>\n        <p>提供桌面客户端，安装后按订阅信息进行配置即可使用。</p>\n        <p class=\"meta\">获取方式：订阅说明 · 下载地址：<a href=\"#\">见订阅页</a></p>\n      </article>\n      <article class=\"client\">\n        <h3>桌面端 · macOS</h3>\n        <p>提供对应的桌面客户端版本，配置流程与桌面端一致。</p>\n        <p class=\"meta\">获取方式：订阅说明 · 下载地址：<a href=\"#\">见订阅页</a></p>\n      </article>\n      <article class=\"client\">\n        <h3>移动端 · iOS</h3>\n        <p>通过系统应用商店获取客户端，具体可用性取决于你所在地区的商店条目。</p>\n        <p class=\"meta\">获取方式：应用商店 · 下载地址：<a href=\"#\">见订阅页</a></p>\n      </article>\n      <article class=\"client\">\n        <h3>移动端 · Android</h3>\n        <p>提供 Android 客户端安装包，安装前请确认来源与你的订阅说明一致。</p>\n        <p class=\"meta\">获取方式：订阅说明 · 下载地址：<a href=\"#\">见订阅页</a></p>\n      </article>\n      <article class=\"client\">\n        <h3>路由器与自建路由</h3>\n        <p>团队版支持企业定制路由；具体配置方式随套餐类型而异。</p>\n        <p class=\"meta\">获取方式：客服对接 · 下载地址：<a href=\"#\">见订阅页</a></p>\n      </article>\n      <article class=\"client\">\n        <h3>订阅信息导入</h3>\n        <p>客户端需导入订阅信息后方可使用；导入步骤随客户端版本不同而略有差异。</p>\n        <p class=\"meta\">获取方式：账户页 · 下载地址：<a href=\"#\">见订阅页</a></p>\n      </article>\n    </div>\n  </section>\n\n  <section class=\"sect wrap\" id=\"faq\">\n    <div class=\"sect-head\">\n      <span class=\"sect-num\">04</span>\n      <h2 id=\"faq-title\">常见问题</h2>\n    </div>\n    <p class=\"sect-note\">以下八条按双栏并列排列，左右两栏互不依赖，可从任意一条开始读。</p>\n    <div class=\"faq\">\n      <article class=\"qa\">\n        <h3><span class=\"q\">Q1</span>三个套餐的主要差别在哪里？</h3>\n        <p><span class=\"a\">A</span>差别集中在三项：每月流量额度、同时在线设备数量、线路与支持类型。基础版为 100GB 与 3 台；旗舰版为 300GB 与 5 台，并额外包含优先工单支持；团队版为 1000GB 与 20 台，并包含企业定制路由与专属客户经理。</p>\n      </article>\n      <article class=\"qa\">\n        <h3><span class=\"q\">Q2</span>年付价格与月付是什么关系？</h3>\n        <p><span class=\"a\">A</span>年付为按年一次性支付的总额：基础版 ¥150/年、旗舰版 ¥350/年、团队版 ¥850/年。它不等同于月付功能的增减，权益条目与同档月付一致。</p>\n      </article>\n      <article class=\"qa\">\n        <h3><span class=\"q\">Q3</span>同时在线设备数如何计算？</h3>\n        <p><span class=\"a\">A</span>按同一时间处于在线状态的设备数量计算，关闭客户端即不再占用名额。若你需要频繁在多台设备之间切换，请参考对照表中的设备行再选择档位。</p>\n      </article>\n      <article class=\"qa\">\n        <h3><span class=\"q\">Q4</span>流量额度每月如何重置？</h3>\n        <p><span class=\"a\">A</span>额度按月计算，具体以你订阅周期对应的重置日期为准。本页不推定未列明的超额处理方式，如遇额度用尽，请以账户页显示为准。</p>\n      </article>\n      <article class=\"qa\">\n        <h3><span class=\"q\">Q5</span>如何开始使用客户端？</h3>\n        <p><span class=\"a\">A</span>先根据你的平台选择对应客户端并完成安装，再从账户页取得订阅信息导入客户端。导入后按客户端提示完成一次连接测试即可。</p>\n      </article>\n      <article class=\"qa\">\n        <h3><span class=\"q\">Q6</span>页面为什么不提供下载链接？</h3>\n        <p><span class=\"a\">A</span>本页无法确认各平台安装包的最新来源，因此不提供具体下载地址。客户端区块中的链接仅作为入口说明，实际获取请以你订阅后收到的说明为准。</p>\n      </article>\n      <article class=\"qa\">\n        <h3><span class=\"q\">Q7</span>团队版的企业定制路由指什么？</h3>\n        <p><span class=\"a\">A</span>指按团队的组织结构规划路由策略的配置方式，配合专属客户经理对接。具体的实施细节不属于本页说明范围，需在开通时确认。</p>\n      </article>\n      <article class=\"qa\">\n        <h3><span class=\"q\">Q8</span>本页未写到的信息如何确认？</h3>\n        <p><span class=\"a\">A</span>本页只陈述已列出的条目，不对未列明的性能、节点数量或覆盖地区作补充。遇到表中未出现的问题，请通过订阅说明中的支持渠道确认。</p>\n      </article>\n    </div>\n  </section>\n\n</main>\n\n<footer class=\"foot wrap\">\n  <div class=\"foot-grid\">\n    <div>\n      <strong>miaoss</strong><br>\n      产品说明页 · 套餐与使用条目以此页所列内容为准\n    </div>\n    <nav aria-label=\"页脚目录\">\n      <a href=\"#read\">阅读方法</a>\n      <a href=\"#plans\">套餐对照</a>\n      <a href=\"#clients\">客户端</a>\n      <a href=\"#faq\">常见问题</a>\n      <a href=\"#top\">回到顶部</a>\n    </nav>\n  </div>\n</footer>",
